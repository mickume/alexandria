{
  // One Worker serves the website's static assets and the API.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alexandria",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Page routes go through the Worker first, so that a visitor without a
    // session is sent to the sign-in page; built files are served directly.
    "run_worker_first": ["/*", "!/assets/*", "!/favicon.svg"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alexandria",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "queues": {
    "producers": [{ "binding": "FETCH_QUEUE", "queue": "alexandria-fetch" }],
    "consumers": [{ "queue": "alexandria-fetch", "max_batch_size": 10, "max_retries": 5 }],
  },
  // One Durable Object per host spaces Alexandria's requests to it a second apart.
  "durable_objects": { "bindings": [{ "name": "HOST_GATE", "class_name": "HostGate" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HostGate"] }],
  // Snapshots and reader views, under u/{user_id}/l/{link_id}/.
  "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "alexandria-snapshots" }],
  "vars": {
    "ALLOWED_EMAILS": "",
    "GOOGLE_CLIENT_ID": "",
    "GOOGLE_AUTH_URL": "https://accounts.google.com/o/oauth2/v2/auth",
    "GOOGLE_TOKEN_URL": "https://oauth2.googleapis.com/token",
    "PUBLIC_ORIGIN": "http://localhost:8787",
    // ORIGIN_PROXY_URL is left unset in production; the end-to-end tests set it.
    "ANTHROPIC_BASE_URL": "https://api.anthropic.com",
    "OPENROUTER_BASE_URL": "https://openrouter.ai/api/v1",
  },
  // GOOGLE_CLIENT_SECRET and KEY_ENCRYPTION_KEY are secrets: `wrangler secret put <NAME>`,
  // or lines in .dev.vars for local development.
  "observability": { "enabled": true },
}
