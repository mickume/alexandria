{
  // One Worker serves the website's static assets and the API.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alexandria",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // A plain `wrangler deploy` (as Workers Builds runs it) builds first: the
  // website into dist/client, and inside Workers Builds the account's D1
  // database, queues, bucket and migrations (scripts/build.sh). Vite ignores
  // this field; `npm run deploy` builds with Vite and deploys its bundle.
  "build": { "command": "scripts/build.sh" },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Page routes go through the Worker first, so that a visitor without a
    // session is sent to the sign-in page; built files are served directly.
    "run_worker_first": ["/*", "!/assets/*", "!/favicon.svg"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      // No database_id: `wrangler deploy` finds the account's database by its
      // name (scripts/provision.sh creates it when it does not exist).
      "database_name": "alexandria",
      "migrations_dir": "migrations",
    },
  ],
  // Hourly: decay and liveness checks; every minute: imports, the index backfill and the
  // deletion of vectors; every 5 minutes: account deletions.
  "triggers": { "crons": ["0 * * * *", "* * * * *", "*/5 * * * *"] },
  "queues": {
    "producers": [
      { "binding": "FETCH_QUEUE", "queue": "alexandria-fetch" },
      { "binding": "ENRICH_QUEUE", "queue": "alexandria-enrich" },
      { "binding": "LIVENESS_QUEUE", "queue": "alexandria-liveness" },
      { "binding": "ACCOUNT_QUEUE", "queue": "alexandria-account" },
      { "binding": "INDEX_QUEUE", "queue": "alexandria-index" },
    ],
    "consumers": [
      { "queue": "alexandria-fetch", "max_batch_size": 10, "max_retries": 5 },
      { "queue": "alexandria-enrich", "max_batch_size": 5, "max_retries": 5 },
      { "queue": "alexandria-liveness", "max_batch_size": 10, "max_retries": 3 },
      { "queue": "alexandria-account", "max_batch_size": 1, "max_retries": 10 },
      { "queue": "alexandria-index", "max_batch_size": 10, "max_retries": 5 },
    ],
  },
  // One Durable Object per host spaces Alexandria's requests to it a second apart.
  "durable_objects": { "bindings": [{ "name": "HOST_GATE", "class_name": "HostGate" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HostGate"] }],
  // Embeddings for search by meaning, computed on the account's Workers AI and
  // kept in a Vectorize index (scripts/provision.sh creates it). `wrangler dev
  // --local` serves neither: the end-to-end tests set MEANING_FAKE_URL instead.
  "ai": { "binding": "AI", "remote": true },
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "alexandria-passages", "remote": true }],
  // Snapshots and reader views, under u/{user_id}/l/{link_id}/.
  "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "alexandria-snapshots" }],
  // The settings every deployment shares. ALLOWED_EMAILS, GOOGLE_CLIENT_ID and
  // PUBLIC_ORIGIN belong to one deployment and are not here: set them, with the
  // secrets GOOGLE_CLIENT_SECRET and KEY_ENCRYPTION_KEY, with `wrangler secret
  // put <NAME>` (or in the dashboard), and in .dev.vars for local development.
  // keep_vars keeps what the dashboard holds across deploys.
  "keep_vars": true,
  "vars": {
    "GOOGLE_AUTH_URL": "https://accounts.google.com/o/oauth2/v2/auth",
    "GOOGLE_TOKEN_URL": "https://oauth2.googleapis.com/token",
    // ORIGIN_PROXY_URL is left unset in production; the end-to-end tests set it.
    "ANTHROPIC_BASE_URL": "https://api.anthropic.com",
    "OPENROUTER_BASE_URL": "https://openrouter.ai/api/v1",
    "FIRECRAWL_API_URL": "https://api.firecrawl.dev",
  },
  "observability": { "enabled": true },
  // Workers Builds runs `wrangler preview` for branches other than main, and
  // that command refuses to run without this block. A Preview gets only what
  // is listed here: the public endpoints above, and none of the production
  // database, bucket, queues or Durable Object, so that a branch can never
  // touch real data. A Preview therefore serves the website, but signing in
  // and the API do not work in it.
  "previews": {
    "vars": {
      "GOOGLE_AUTH_URL": "https://accounts.google.com/o/oauth2/v2/auth",
      "GOOGLE_TOKEN_URL": "https://oauth2.googleapis.com/token",
      "ANTHROPIC_BASE_URL": "https://api.anthropic.com",
      "OPENROUTER_BASE_URL": "https://openrouter.ai/api/v1",
      "FIRECRAWL_API_URL": "https://api.firecrawl.dev",
    },
  },
}
