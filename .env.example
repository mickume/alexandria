# The settings of one deployment, for `npm run configure` (scripts/configure.sh),
# which stores each as a secret of the Worker. Copy this file to .env, which git
# ignores, and fill it in. Quote a value that holds # or spaces. A setting left
# out of .env is left as it is on Cloudflare. See docs/configuration.md.

# Comma-separated email addresses that may sign in.
ALLOWED_EMAILS=
# The OAuth 2.0 client of the Google Cloud project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: the AI provider that enriches links, answers Ask and splits topics
# for every owner: anthropic (the default) or openrouter, its model (needed
# with OpenRouter; Anthropic's default is claude-opus-5-5) and its API key.
# Without AI_API_KEY, nothing is enriched.
# AI_PROVIDER=anthropic
# AI_MODEL=
# AI_API_KEY=
# Optional: a Firecrawl API key, so that pages behind a bot check are fetched
# through Firecrawl, using its credits.
# FIRECRAWL_API_KEY=
# Optional: the site's own origin, such as https://alexandria.example.com.
# PUBLIC_ORIGIN=
# Optional: a GitHub token (a fine-grained token with no repository access
# will do), so that GitHub links are retrieved through GitHub's API with its
# higher rate limit.
# GITHUB_TOKEN=
# Optional: a Google Cloud API key with the YouTube Data API v3 enabled, so
# that YouTube videos are retrieved through YouTube's API. Without it, their
# pages are fetched as other pages are.
# YOUTUBE_API_KEY=

# Optional: how the script reaches the account, when not already set in the
# environment. They are never uploaded.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
