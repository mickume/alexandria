# The settings of one deployment, for `npm run configure` (scripts/configure.sh),
# which stores each as a secret of the Worker. Copy this file to .env, which git
# ignores, and fill it in. Quote a value that holds # or spaces. A setting left
# out of .env is left as it is on Cloudflare. See docs/configuration.md.

# Comma-separated email addresses that may sign in.
ALLOWED_EMAILS=
# The OAuth 2.0 client of the Google Cloud project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string, such as the output of `openssl rand -base64 48`.
# Changing it makes every stored AI and Firecrawl key unreadable.
KEY_ENCRYPTION_KEY=
# Optional: the site's own origin, such as https://alexandria.example.com.
# PUBLIC_ORIGIN=

# Optional: how the script reaches the account, when not already set in the
# environment. They are never uploaded.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
